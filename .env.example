# Application
APP_NAME=BIS Intelligent Assistant
APP_ENV=development
DEBUG=true

# Database — format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://bis_user:change_me@localhost:5432/bis_db

# Optional: separate database for running integration tests (pytest)
# TEST_DATABASE_URL=postgresql+psycopg2://bis_user:change_me@localhost:5432/bis_test

# Embeddings (Milestone 2) — local model, no API key required.
# Override to try a different sentence-transformers model, e.g. a
# multilingual one when Hindi content is ingested:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Answer generation (Milestone 4) — safe/offline by default.
# "extractive" (default): deterministic, no API key needed, no network calls.
# "llm": real LLM-backed generation (see backend/app/services/answer_generation.py).
#        If selected without OPENAI_API_KEY set below, it automatically falls
#        back to "extractive" behaviour on every request rather than failing.
# ANSWER_PROVIDER=extractive

# Required ONLY if ANSWER_PROVIDER=llm. Never commit a real value here —
# put your real key in your local .env (already git-ignored), never in
# this .env.example file or in source code.
# OPENAI_API_KEY=

# Optional LLM tuning (all have safe defaults if unset):
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_TEMPERATURE=0.0
# LLM_MAX_OUTPUT_TOKENS=600
# LLM_TIMEOUT_SECONDS=20

# Reserved for later stages (do not put real secrets here)
# ANTHROPIC_API_KEY=
